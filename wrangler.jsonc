{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitrep-www",
  "compatibility_date": "2026-08-01",
  // The account has no workers.dev subdomain on purpose; every deploy target
  // is a custom domain on the sitrep.md zone. Custom domains (sitrep.md ->
  // sitrep-www, dev.sitrep.md -> sitrep-www-dev) are attached once via the
  // account-level workers/domains API, not declared here: the CI token has no
  // zone-level Workers Routes permission, and a `routes` entry would make
  // every deploy try (and fail) to re-sync them.
  "workers_dev": false,
  // worker/index.js runs only for /releases/* and counts update checks into
  // D1 (sitrep docs/decisions.md, "How sitrep.md counts installs"); every
  // other path is served by the assets without running a script.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/releases/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "sitrep-installs", "database_id": "66114b67-97fa-40e1-813e-93146f265240" }
  ],
  "env": {
    "dev": {
      "name": "sitrep-www-dev",
      "workers_dev": false,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": ["/releases/*"]
      },
      // Same database; rows carry the host, so dev.sitrep.md checks never
      // mix into sitrep.md's counts.
      "d1_databases": [
        { "binding": "DB", "database_name": "sitrep-installs", "database_id": "66114b67-97fa-40e1-813e-93146f265240" }
      ]
    }
  }
}
