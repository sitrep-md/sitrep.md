---
import Sitrep from './Sitrep.astro';

const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-5xl px-6 pt-20 pb-10">
  <div class="border-t border-line pt-8 text-xs text-ink-faint">
    <p class="max-w-prose">
      <Sitrep /> is an AI project status dashboard: a state layer on top of the
      markdown your AI agents already generate. Local-first. Your files never
      leave your machine.
    </p>
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
      <a href="/how-it-works/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">How it works</a>
      <a href="/about/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">About</a>
      <a href="/principles/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Principles</a>
      <a href="/security/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Security &amp; privacy</a>
      <a href="/faq/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">FAQ</a>
      <a href="/changelog/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Changelog</a>
      <a href="/vs/obsidian-dataview/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Obsidian&nbsp;+&nbsp;Dataview</a>
      <a href="/vs/backlog-md/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Backlog.md</a>
      <a href="/vs/nimbalyst/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Nimbalyst</a>
      <a href="/vs/vscode-claude-md/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs VS&nbsp;Code&nbsp;+&nbsp;CLAUDE.md</a>
      <a href="/vs/beads/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Beads</a>
      <a href="/vs/task-master/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Task&nbsp;Master</a>
      <a href="/vs/agentsview/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs AgentsView</a>
      <a href="/vs/just-ask-your-agent/" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs just&nbsp;asking&nbsp;your&nbsp;agent</a>
      <a href="/llms.txt" class="hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">llms.txt</a>
      <span class="ml-auto">&copy; {year} sitrep.md</span>
    </div>
  </div>
</footer>
