---
import Sitrep from './Sitrep.astro';

const year = new Date().getFullYear();

const product = [
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/download/', label: 'Download' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/principles/', label: 'Principles' },
  { href: '/security/', label: 'Security & privacy' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/about/', label: 'About' },
];

const compare = [
  { href: '/vs/obsidian-dataview/', label: 'Obsidian + Dataview' },
  { href: '/vs/backlog-md/', label: 'Backlog.md' },
  { href: '/vs/nimbalyst/', label: 'Nimbalyst' },
  { href: '/vs/vscode-claude-md/', label: 'VS Code + CLAUDE.md' },
  { href: '/vs/beads/', label: 'Beads' },
  { href: '/vs/task-master/', label: 'Task Master' },
  { href: '/vs/agentsview/', label: 'AgentsView' },
  { href: '/vs/just-ask-your-agent/', label: 'Just asking your agent' },
];

const linkClass =
  'inline-block py-0.5 text-ink-faint transition-colors hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<footer class="mx-auto w-full max-w-5xl px-6 pt-20 pb-10">
  <div class="border-t border-line pt-10">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between sm:gap-16">
      <p class="max-w-xs text-xs text-ink-faint">
        <Sitrep /> is an AI project status dashboard: a state layer on top of
        the markdown your AI agents already generate. Local-first.
      </p>
      <div class="grid grid-cols-2 gap-8 sm:flex sm:gap-16">
        <nav aria-label="Product" class="text-xs">
          <p class="font-medium text-ink-muted">Product</p>
          <ul class="mt-3 flex flex-col gap-1.5">
            {product.map(({ href, label }) => (
              <li><a href={href} class={linkClass}>{label}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Comparisons" class="text-xs">
          <p class="font-medium text-ink-muted"><Sitrep /> vs</p>
          <ul class="mt-3 flex flex-col gap-1.5">
            {compare.map(({ href, label }) => (
              <li><a href={href} class={linkClass}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-6 text-xs text-ink-faint">
      <a href="https://github.com/sitrep-md/sitrep.md" rel="noopener" class="transition-colors hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">GitHub</a>
      <a href="/llms.txt" class="transition-colors hover:text-ink-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">llms.txt</a>
      <span class="ml-auto">&copy; {year} sitrep.md</span>
    </div>
  </div>
</footer>
