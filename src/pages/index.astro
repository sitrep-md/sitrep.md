---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Sitrep from '../components/Sitrep.astro';

const appSchema = [
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://sitrep.md/#app',
    name: 'sitrep',
    url: 'https://sitrep.md/',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS',
    downloadUrl: 'https://sitrep.md/download/',
    offers: [
      { '@type': 'Offer', price: '49', priceCurrency: 'EUR', url: 'https://sitrep.md/pricing/' },
      { '@type': 'Offer', price: '49', priceCurrency: 'USD', url: 'https://sitrep.md/pricing/' },
    ],
    description:
      'sitrep is an AI project status dashboard: a state layer on top of the markdown your AI agents already generate. It reads the plans, decisions and progress your AI agents already write - no new format, no import - and shows status, phases, open decisions and staleness across every project.',
    featureList: [
      'Reads Claude Code, Cursor and Codex markdown across all your projects',
      'Extracts status, phases, decisions and due dates from the conventions already in your docs',
      'Email-client-style overview - newest activity first, pending items surfaced',
      'Surfaces the decisions still waiting on you',
      'Staleness signals - flags the docs that claim work your repo has moved past: dead claims, adrift master plans, left-behind docs, stale status lines',
      'Live refresh in place - the page is never taken away from you',
      'Local-first: files never leave your machine, no account, no telemetry by default',
    ],
  },
];

const promises = [
  { title: 'Zero adoption cost', body: 'reads what agents already write - no format, no import, no restructuring.' },
  { title: 'State first', body: 'an email client for project state, not a file tree.' },
  { title: 'Reading parity', body: 'full GFM, code, Mermaid, KaTeX - rendering is the floor, not the product.' },
  { title: 'Nothing takes the page away', body: 'live refresh lands in place; reload restores your position.' },
  { title: 'One writing surface', body: 'three guarded ops; no other code path ever writes to your files.' },
  { title: 'Local-first and private', body: 'fully functional with no account and no network, no telemetry by default.' },
  { title: 'Fast', body: 'kernel file events, instant search - work scales with what changed.' },
  { title: 'Honest', body: 'claims are measured before they are made.' },
];

---

<BaseLayout
  title="sitrep - AI project status dashboard"
  description="sitrep is an AI project status dashboard: a state layer on top of the markdown your AI agents already generate. Never open a cold project again."
  schema={appSchema}
>
  <Nav />

  <main class="mx-auto w-full max-w-5xl px-6">
    <!-- Hero -->
    <section class="flex flex-col items-start gap-6 pt-[12vh] pb-10 sm:pb-12">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">For Claude Code, Cursor and Codex workflows</p>
      <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Never open a cold project again.
      </h1>
      <p class="max-w-prose text-lg text-ink-muted">
        Your agents already wrote down what happened - plans, decisions and
        progress notes scattered across your repos. <Sitrep /> turns that
        markdown into a live view of where every project stands: what moved,
        what is stalled, what is waiting on you.
      </p>
    </section>

    <!-- Product shots: the live view and the attention lens, one carousel.
         The breakout margins let the shots render wider than the prose
         column - the captures are 1536px (the app's narrowest split view),
         and every pixel of display width is legibility. -->
    <section class="pb-16 sm:pb-20 xl:-mx-20 2xl:-mx-44" aria-label="Product screenshots">
      <div data-carousel>
        <div class="relative">
          <div
            class="overflow-hidden"
            data-carousel-viewport
            tabindex="0"
            role="group"
            aria-roledescription="carousel"
            aria-label="Product screenshots"
          >
            <div class="flex" style="touch-action: pan-y pinch-zoom">
              <figure class="m-0 w-full min-w-0 flex-shrink-0" role="group" aria-roledescription="slide" aria-label="1 of 2">
                <div class="overflow-hidden rounded-xl border border-line bg-surface-raised">
                  <img
                    src="/screenshots/hero-light.webp"
                    width="1536"
                    height="920"
                    alt="The sitrep shell: an email-client-style project list - a plan edited minutes ago above work from hours and days back, a blocked deploy note with uncommitted edits, a gitignored scratch file, an untracked status doc - beside an open implementation plan with its phase meter, decision table and due date."
                    class="w-full dark:hidden"
                    decoding="async"
                  />
                  <img
                    src="/screenshots/hero-dark.webp"
                    width="1536"
                    height="920"
                    alt="The sitrep shell in dark theme: an email-client-style project list - a plan edited minutes ago above work from hours and days back, a blocked deploy note with uncommitted edits, a gitignored scratch file, an untracked status doc - beside an open implementation plan with its phase meter, decision table and due date."
                    class="hidden w-full dark:block"
                    decoding="async"
                  />
                </div>
              </figure>
              <figure class="m-0 w-full min-w-0 flex-shrink-0" role="group" aria-roledescription="slide" aria-label="2 of 2">
                <div class="overflow-hidden rounded-xl border border-line bg-surface-raised">
                  <img
                    src="/screenshots/attention-light.webp"
                    width="1536"
                    height="920"
                    alt="The Needs attention view: the same list narrowed to open decisions, a blocked and overdue note, and left-behind plans from one to six months old, with a stale plan open in the reader wearing its badge."
                    class="w-full dark:hidden"
                    loading="lazy"
                    decoding="async"
                  />
                  <img
                    src="/screenshots/attention-dark.webp"
                    width="1536"
                    height="920"
                    alt="The Needs attention view in dark theme: the same list narrowed to open decisions, a blocked and overdue note, and left-behind plans from one to six months old, with a stale plan open in the reader wearing its badge."
                    class="hidden w-full dark:block"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </figure>
            </div>
          </div>
          <button
            data-carousel-prev
            aria-label="Previous screenshot"
            class="absolute top-1/2 left-3 hidden size-9 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-surface/85 text-ink-muted backdrop-blur transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:flex"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button
            data-carousel-next
            aria-label="Next screenshot"
            class="absolute top-1/2 right-3 hidden size-9 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-surface/85 text-ink-muted backdrop-blur transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:flex"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
        <div class="mt-4 flex items-center justify-center gap-2" role="group" aria-label="Screenshot picker">
          <button data-carousel-dot="0" aria-label="Screenshot 1" class="h-1.5 w-6 rounded-full bg-accent transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"></button>
          <button data-carousel-dot="1" aria-label="Screenshot 2" class="h-1.5 w-1.5 rounded-full bg-line transition-all hover:bg-ink-faint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"></button>
        </div>
      </div>
      <div class="mt-10 flex flex-col items-center gap-4">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/download/"
            class="rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-surface transition-colors hover:bg-accent/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Download for macOS
          </a>
          <a
            href="/pricing/"
            class="rounded-lg border border-line px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink-faint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Pricing
          </a>
        </div>
        <p class="text-sm text-ink-faint">
          Free 14-day trial - the full product, no card, no account. Then
          &euro;49, once - keep it forever.
        </p>
      </div>
    </section>

    <script>
      import EmblaCarousel from "embla-carousel";
      import Autoplay from "embla-carousel-autoplay";

      const root = document.querySelector<HTMLElement>("[data-carousel]");
      const viewport = root?.querySelector<HTMLElement>("[data-carousel-viewport]");
      if (root && viewport) {
        const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]")];
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const embla = EmblaCarousel(
          viewport,
          { loop: true, duration: reduced ? 0 : 22 },
          reduced ? [] : [Autoplay({ delay: 7000, stopOnInteraction: true, stopOnMouseEnter: true })],
        );
        const stop = () => embla.plugins().autoplay?.stop();

        const sync = () => {
          const active = embla.selectedScrollSnap();
          dots.forEach((dot, i) => {
            dot.classList.toggle("w-6", i === active);
            dot.classList.toggle("bg-accent", i === active);
            dot.classList.toggle("w-1.5", i !== active);
            dot.classList.toggle("bg-line", i !== active);
            dot.setAttribute("aria-current", String(i === active));
          });
        };
        embla.on("select", sync);
        sync();

        dots.forEach((dot, i) =>
          dot.addEventListener("click", () => {
            stop();
            embla.scrollTo(i);
          }),
        );
        root.querySelector("[data-carousel-prev]")?.addEventListener("click", () => {
          stop();
          embla.scrollPrev();
        });
        root.querySelector("[data-carousel-next]")?.addEventListener("click", () => {
          stop();
          embla.scrollNext();
        });
        viewport.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
          e.preventDefault();
          stop();
          e.key === "ArrowLeft" ? embla.scrollPrev() : embla.scrollNext();
        });
        root.addEventListener("focusin", stop);
      }
    </script>

    <!-- The problem -->
    <section class="border-t border-line py-16 sm:py-20" aria-labelledby="problem">
      <h2 id="problem" class="text-2xl font-semibold tracking-tight">
        The first fifteen minutes of every session
      </h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        <p class="max-w-prose text-ink-muted">
          Run Claude Code, Cursor or Codex across a few projects and the
          plans, analyses and decision documents pile up. You asked for every
          one of them: an analysis before each decision, a plan before each
          build. Nobody keeps that in their head. The state of your work is
          written down - it is just scattered across hundreds of markdown
          files in a dozen repos.
        </p>
        <p class="max-w-prose text-ink-muted">
          So every return to a cold project starts the same way: scrolling
          old chats, re-opening docs, re-deriving where things
          stand. <Sitrep /> exists so that re-entry stops costing the first
          fifteen minutes of a session. Open it, see the situation, resume.
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section class="border-t border-line py-16 sm:py-20" aria-labelledby="how">
      <h2 id="how" class="text-2xl font-semibold tracking-tight">How it works</h2>
      <ol class="mt-8 grid gap-8 sm:grid-cols-3">
        <li class="flex flex-col gap-2">
          <span class="text-xs font-medium text-accent">01</span>
          <h3 class="font-medium">Point it at folders</h3>
          <p class="text-sm text-ink-muted">
            No import, no vault. <Sitrep /> indexes the markdown already on your
            disk and watches it with kernel events - a corpus of tens of
            thousands of files narrows to the few hundred documents that are
            actually project docs.
          </p>
        </li>
        <li class="flex flex-col gap-2">
          <span class="text-xs font-medium text-accent">02</span>
          <h3 class="font-medium">It extracts the state</h3>
          <p class="text-sm text-ink-muted">
            Status lines, phase headings, decision tables, due dates - the
            conventions agents and humans already use are parsed into
            structured state. Extraction vocabularies are <strong class="font-medium text-ink">editable settings</strong>,
            never demands on your files.
          </p>
        </li>
        <li class="flex flex-col gap-2">
          <span class="text-xs font-medium text-accent">03</span>
          <h3 class="font-medium">Triage, not archaeology</h3>
          <p class="text-sm text-ink-muted">
            An email-client-style overview: newest activity first, pending
            decisions surfaced, what the docs claim beside when they last
            changed. Click through to read any doc in full fidelity.
          </p>
        </li>
      </ol>
      <p class="mt-8 text-sm">
        <a href="/how-it-works/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          The conventions it reads, in detail
        </a>
      </p>
    </section>

    <!-- Price -->
    <section class="border-t border-line py-16 sm:py-20" aria-labelledby="price">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="price" class="text-2xl font-semibold tracking-tight">&euro;49. Once.</h2>
          <p class="mt-3 max-w-prose text-ink-muted">
            A year of updates included, and the license is perpetual - the app
            keeps working forever, offline, with no account. The 14-day trial
            is the full product.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/download/"
            class="rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-surface transition-colors hover:bg-accent/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Download for macOS
          </a>
          <a
            href="/pricing/"
            class="rounded-lg border border-line px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink-faint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Pricing details
          </a>
        </div>
      </div>
    </section>

    <!-- Promises -->
    <section class="border-t border-line py-16 sm:py-20" aria-labelledby="promises">
      <h2 id="promises" class="text-2xl font-semibold tracking-tight">The product contract</h2>
      <p class="mt-3 max-w-prose text-ink-muted">
        Eight promises every feature is tested against:
      </p>
      <ul class="mt-6 grid max-w-4xl gap-x-10 gap-y-3 sm:grid-cols-2">
        {
          promises.map(({ title, body }) => (
            <li class="text-sm">
              <span class="font-medium">{title}</span>
              <span class="text-ink-muted"> - {body}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-prose text-ink-muted">
        And a binding list of nevers: not an editor, not a task manager, not
        an agent orchestrator, not a second brain, not a cloud-only account.
      </p>
      <p class="mt-6 text-sm">
        <a href="/principles/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          All eight promises and the full anti-roadmap
        </a>
      </p>
    </section>

    <!-- Comparison -->
    <section class="border-t border-line py-16 sm:py-20" aria-labelledby="fits">
      <h2 id="fits" class="text-2xl font-semibold tracking-tight">Where <Sitrep /> fits</h2>
      <p class="mt-3 max-w-prose text-ink-muted">
        Every adjacent tool asks you to author project state - in its format,
        inside its walls, or by asking an agent to re-derive it every
        time. <Sitrep /> discovers the state your files already contain. Each
        comparison below names when the other approach is the better
        choice.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[44rem] border-collapse text-sm">
          <thead>
            <tr class="border-b border-line text-left">
              <th scope="col" class="py-3 pr-4 font-medium">Tool</th>
              <th scope="col" class="py-3 pr-4 font-medium">What it is</th>
              <th scope="col" class="py-3 pr-4 font-medium">How you get project state</th>
              <th scope="col" class="py-3 font-medium">Comparison</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium"><Sitrep /></th>
              <td class="py-3 pr-4 text-ink-muted">AI project status dashboard</td>
              <td class="py-3 pr-4 text-ink-muted">Point it at folders - it parses the markdown your agents already wrote, across every project</td>
              <td class="py-3 text-ink-muted">-</td>
            </tr>
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium">Backlog.md</th>
              <td class="py-3 pr-4 text-ink-muted">Git-native task board</td>
              <td class="py-3 pr-4 text-ink-muted">You and your agents author tasks in its format, per repo</td>
              <td class="py-3"><a href="/vs/backlog-md/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Backlog.md</a></td>
            </tr>
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium">Obsidian + Dataview</th>
              <td class="py-3 pr-4 text-ink-muted">Knowledge base + query plugin</td>
              <td class="py-3 pr-4 text-ink-muted">You structure notes with frontmatter and build dashboards by hand</td>
              <td class="py-3"><a href="/vs/obsidian-dataview/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Obsidian&nbsp;+&nbsp;Dataview</a></td>
            </tr>
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium">Nimbalyst</th>
              <td class="py-3 pr-4 text-ink-muted">Visual agent workspace</td>
              <td class="py-3 pr-4 text-ink-muted">You run sessions inside it and track them there</td>
              <td class="py-3"><a href="/vs/nimbalyst/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Nimbalyst</a></td>
            </tr>
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium">Beads</th>
              <td class="py-3 pr-4 text-ink-muted">Agent-first issue tracker</td>
              <td class="py-3 pr-4 text-ink-muted">Agents plan and close work in its git-synced database, per repo</td>
              <td class="py-3"><a href="/vs/beads/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Beads</a></td>
            </tr>
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium">Task Master</th>
              <td class="py-3 pr-4 text-ink-muted">PRD-to-tasks for agents</td>
              <td class="py-3 pr-4 text-ink-muted">You write a PRD; it generates tasks your agent executes</td>
              <td class="py-3"><a href="/vs/task-master/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs Task Master</a></td>
            </tr>
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium">AgentsView</th>
              <td class="py-3 pr-4 text-ink-muted">Agent session analytics</td>
              <td class="py-3 pr-4 text-ink-muted">It indexes session transcripts - activity and cost, not doc state</td>
              <td class="py-3"><a href="/vs/agentsview/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs AgentsView</a></td>
            </tr>
            <tr class="border-b border-line align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium">Plain VS Code + CLAUDE.md</th>
              <td class="py-3 pr-4 text-ink-muted">The free DIY default</td>
              <td class="py-3 pr-4 text-ink-muted">You read the files and keep the state in your head</td>
              <td class="py-3"><a href="/vs/vscode-claude-md/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs VS&nbsp;Code&nbsp;+&nbsp;CLAUDE.md</a></td>
            </tr>
            <tr class="align-top">
              <th scope="row" class="py-3 pr-4 text-left font-medium">Just asking your agent</th>
              <td class="py-3 pr-4 text-ink-muted">The null alternative - a prompt, not a tool</td>
              <td class="py-3 pr-4 text-ink-muted">The agent re-reads the docs and composes a summary, per ask, per project</td>
              <td class="py-3"><a href="/vs/just-ask-your-agent/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">vs just asking your agent</a></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-6 max-w-prose text-sm text-ink-faint">
        Markdown viewers are deliberately absent: <Sitrep /> renders markdown
        at full fidelity, but a viewer answers "show me this file"
        - the job here is "where do my projects stand".
      </p>
    </section>

    <!-- Honesty -->
    <section class="border-t border-line py-16 sm:py-20" aria-labelledby="measured">
      <h2 id="measured" class="text-2xl font-semibold tracking-tight">Measured, not asserted</h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        <p class="max-w-prose text-ink-muted">
          <Sitrep /> is built over a real working corpus: roughly 69,200 markdown
          files across four workspaces, of which about 806 are actual project
          documents. Every extraction rule is measured against that corpus
          before it ships, and every UI claim is verified by driving the real
          app in headless Chrome and reading numbers back.
        </p>
        <p class="max-w-prose text-ink-muted">
          The same standard applies to what we say here. Claims stay concrete
          and checkable - which agents it reads, what it extracts, what it
          refuses to do - and the comparison pages say when you should pick
          the other tool. When a public claim turns out wrong, it
          gets a dated entry in the <a href="https://github.com/sitrep-md/sitrep.md/blob/main/CORRECTIONS.md" rel="noopener" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">public corrections ledger</a> - what was claimed, who caught it, and what changed.
        </p>
      </div>
      <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/security/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          Security &amp; privacy, and how to verify it
        </a>
        <a href="/about/" class="text-accent underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
          Who builds <Sitrep />, and against what corpus
        </a>
      </p>
    </section>

    <!-- FAQ teaser -->
    <section class="border-t border-line py-16 sm:py-20" aria-labelledby="faq-teaser">
      <h2 id="faq-teaser" class="text-2xl font-semibold tracking-tight">Common questions</h2>
      <dl class="mt-8 grid gap-8 sm:grid-cols-3">
        <div class="flex flex-col gap-1.5">
          <dt class="font-medium">Do I need to change my files?</dt>
          <dd class="text-sm text-ink-muted">
