---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Sitrep from '../components/Sitrep.astro';

const promises = [
  {
    title: '1. Zero adoption cost',
    body: 'sitrep reads what agents already write - no new format, no frontmatter requirement, no import, no vault, no restructuring. Point it at folders. Extraction conventions are editable settings, never demands on your files.',
  },
  {
    title: '2. Every repo, one list',
    body: 'Docs from every folder you point it at land in one list, newest activity first. Status, phases, decisions, due dates and staleness sit beside each doc, so the list says which one to open before you open it.',
  },
  {
    title: '3. Reading comes first',
    body: 'Reading agent docs is the main job: full GFM, syntax-highlighted code with copy buttons, offline theme-aware Mermaid, KaTeX, callouts, and no lag on multi-thousand-line files. What you read leaves the app in a usable shape: a table pastes as a table, a path as a path.',
  },
  {
    title: '4. Nothing takes the page away from you',
    body: 'Live refresh in place, scroll re-anchored, reload restores position, Esc peels one layer. The reader\'s state is never the app\'s to reset.',
  },
  {
    title: '5. One writing surface',
    body: 'Three convention-shaped ops - status, due, supersede - behind a preview and a content-hash guard are the only code path that ever writes to your documents. View transforms are local state with export, never a write.',
  },
  {
    title: '6. Local-first and private',
    body: 'Fully functional forever with no account and no network. Files never leave the machine unless sync is explicitly enabled; sync is end-to-end encrypted with user-held keys. No telemetry by default.',
  },
  {
    title: '7. Fast',
    body: 'Instant startup on kernel file events - never a tree walk. Instant search. Work stays proportional to what changed, never to corpus size.',
  },
  {
    title: '8. Honest',
    body: 'Claims are measured before they are made - in the UI, in comparisons, and in community participation. Concrete and checkable beats superlatives; no astroturfing, ever.',
  },
];

const never = [
  {
    what: 'A markdown editor',
    why: 'Agents and your editor write the docs. sitrep reads them. Its three guarded edits are the only exception, and the list will not grow into an editor.',
  },
  {
    what: 'Agent orchestration or a parallel-session runner',
    why: 'Steering agents is a different product and contradicts the passive-overview identity. sitrep shows state; it does not drive.',
  },
  {
    what: 'A task manager with its own authored format',
    why: 'Authoring structured tasks is the exact friction sitrep removes. The moment it dictates a format, zero adoption cost is gone.',
  },
  {
    what: 'A second brain or Notion/Obsidian replacement',
    why: 'Search stays scoped to the docs it parses - jump to the decision. No vaults, no backlink graphs, no embeddings without a measured need.',
  },
  {
    what: 'Live agent control from mobile',
    why: 'The mobile mirror is for reading. It is read-only, and it will not grow buttons that start, stop or prompt an agent.',
  },
  {
    what: 'A transcript or session browser',
    why: 'sitrep reads the docs your agents write, never their chat transcripts. Transcripts hold more than you chose to keep, and other tools index them already.',
  },
  {
    what: 'A cloud-only or account-required core',
    why: 'That would delete the local-first promise, and with it the reason the product can be trusted with your files at all.',
  },
];
---

<BaseLayout
  title="Principles - how sitrep is built"
  description="The eight promises sitrep, the AI agent docs reader, is tested against and the things it will not build: no editor, no agent orchestration, no transcript reading, no account-required core."
>
  <Nav />

  <main class="mx-auto w-full max-w-5xl px-6">
    <header class="flex flex-col gap-4 pt-16 pb-12 sm:pt-20">
      <p class="text-xs font-medium tracking-widest text-accent uppercase">Principles</p>
      <h1 class="max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
        How sitrep is built
      </h1>
      <p class="max-w-prose text-lg text-ink-muted">
        <Sitrep /> is an AI agent docs reader, and it comes with a list of
        things it will not become. Both halves are written down,
        and every feature is tested against them. A feature that breaks a
        promise is wrong even if it is useful.
      </p>
    </header>

    <section class="border-t border-line py-12 sm:py-16" aria-labelledby="the-promises">
      <h2 id="the-promises" class="text-xl font-semibold tracking-tight">The eight promises</h2>
      <ul class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          promises.map(({ title, body }) => (
            <li class="flex max-w-prose flex-col gap-1.5">
              <h3 class="font-medium">{title}</h3>
              <p class="text-sm text-ink-muted">{body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-t border-line py-12 sm:py-16" aria-labelledby="anti-roadmap">
      <h2 id="anti-roadmap" class="text-xl font-semibold tracking-tight">What it will not become</h2>
      <p class="mt-3 max-w-prose text-ink-muted">
        Not an editor, not an agent runner, not a Notion or Obsidian
        replacement. Each refusal has a reason. A feature that drifts toward
        one of them does not ship.
      </p>
      <dl class="mt-8 grid gap-7">
        {
          never.map(({ what, why }) => (
            <div class="flex max-w-2xl flex-col gap-1.5">
              <dt class="flex gap-3 font-medium">
                <span aria-hidden="true" class="text-ink-faint select-none">&times;</span>
                {what}
              </dt>
              <dd class="pl-6 text-sm text-ink-muted">{why}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="border-t border-line py-12 sm:py-16" aria-labelledby="held">
      <h2 id="held" class="text-xl font-semibold tracking-tight">How the contract is held</h2>
      <div class="mt-5 flex max-w-prose flex-col gap-4 text-ink-muted">
        <p>
          These are not aspirations on a wall. The promises live in the
          repository as a cross-session contract that every working session -
          human or agent - loads before building anything; a task that
          conflicts with a rule stops rather than builds. Decisions, rejected
          alternatives and open questions are recorded in a decisions table
          that the product itself parses - <Sitrep /> reads its own decision log
          as a fixture, so a regression in the extractor shows up as a moved
          number in its own docs.
        </p>
        <p>
          If a promise here ever stops being true, that is a bug with the
          same priority as one in code.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
